# .env.example — Plantilla de variables de entorno
# Copie este archivo como .env y llene los valores reales antes de hacer build.
# NUNCA suba el .env real a git (ya está en .gitignore).

# ─── MCP MySQL (solo para desarrollo local con el servidor MCP) ──────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
# URL base del servidor de APIs PHP.
# Para All Season Flowers (producción):
#   VITE_API_BASE=https://portal.datenbankensoluciones.com.co/DatenBankenApp/AllSeasonFlowers/Api
# Para otro cliente (ejemplo):
#   VITE_API_BASE=https://mi-servidor.com/OtroCliente/Api
VITE_API_BASE=

# Ruta base de la SPA (debe coincidir con la configuración del servidor web).
# Para All Season Flowers: /DatenBankenApp/AllSeasonFlowers/
# Para otro cliente:       /OtroCliente/
VITE_BASE_PATH=/
